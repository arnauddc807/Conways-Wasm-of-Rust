{
  "name": "conways-wasm-of-rust",
  "version": "0.1.0",
  "description": "Conway's Game of Life in Rust and WebAssembly, packaged for iOS",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "webpack serve",
    "build": "webpack --mode production",
    "ios:sync": "npm run build && cap sync ios",
    "ios:add": "npm run build && cap add ios",
    "ios:open": "cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnauddc807/Conways-Wasm-of-Rust.git"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "rust",
    "webpack",
    "ios",
    "capacitor",
    "game-of-life"
  ],
  "author": "Arnaud De Cuyper <arnaud.de.cuyper@telenet.be>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/Arnauddc807/Conways-Wasm-of-Rust/issues"
  },
  "homepage": "https://github.com/Arnauddc807/Conways-Wasm-of-Rust#readme",
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "wasm-game-of-life": "file:../pkg"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  }
